<group name="local,syslog,sshd,">

  <!-- Regra original -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- PowerShell Script Block Logging -->
  <rule id="100002" level="7">
    <if_sid>91816</if_sid>
    <description>Windows PowerShell: Script Block Logging detected.</description>
    <group>powershell,windows,execution,</group>
  </rule>

  <!-- Windows - Criação de nova conta de usuário -->
  <rule id="100003" level="10">
    <if_sid>60109</if_sid>
    <description>Windows: Nova conta de usuário criada no endpoint.</description>
    <group>windows,account_creation,security,</group>
  </rule>

</group>
